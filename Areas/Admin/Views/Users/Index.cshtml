@model IReadOnlyList<AdminUserViewModel>
@{
    ViewData["Title"] = "Users";
}

<h1 class="h3 mb-3">Users</h1>
<p class="text-muted">Registered citizens. NID is a simulated national identity number used for this demo only — it is not linked to any real government system.</p>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-3 mb-0">No users found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Name</th>
                            <th>Email</th>
                            <th>NID (simulated)</th>
                            <th>Roles</th>
                            <th>Joined</th>
                            <th>Status</th>
                            <th class="pe-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            var isAdmin = u.Roles.Contains("Admin");
                            <tr>
                                <td class="ps-3 fw-semibold">@u.FullName</td>
                                <td>@u.Email</td>
                                <td><code class="small">@u.NID</code></td>
                                <td>
                                    @foreach (var r in u.Roles)
                                    {
                                        <span class="badge @(r == "Admin" ? "bg-dark" : "bg-secondary") me-1">@r</span>
                                    }
                                </td>
                                <td class="small text-muted">@u.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (u.IsLockedOut)
                                    {
                                        <span class="badge bg-danger">Locked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    @if (isAdmin)
                                    {
                                        <span class="text-muted small">Protected</span>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleLock" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm @(u.IsLockedOut ? "btn-outline-success" : "btn-outline-danger")">
                                                <i class="bi @(u.IsLockedOut ? "bi-unlock" : "bi-lock")"></i>
                                                @(u.IsLockedOut ? "Unlock" : "Lock")
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
