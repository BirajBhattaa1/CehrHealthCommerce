@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle text-danger" style="font-size:4rem;"></i>
    <h1 class="h3 text-danger mt-3">Something went wrong</h1>
    <p class="text-muted">An error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-4"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom">Back to home</a>
</div>
