@model NepalMediHub.Models.Product

<div class="col">
    <div class="card h-100 product-tile shadow-sm">
        <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="text-decoration-none">
            <div class="product-image-wrapper">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" loading="lazy" />
                }
                else
                {
                    <div class="product-image-placeholder">
                        <i class="bi bi-capsule-pill" style="color: var(--primary-teal); font-size: 3rem;"></i>
                    </div>
                }
            </div>
        </a>
        <div class="card-body d-flex flex-column">
            <span class="badge text-bg-light text-muted mb-2">@Model.Category?.Name</span>
            <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="text-decoration-none text-dark">
                <h3 class="h6 card-title fw-semibold">@Model.Name</h3>
            </a>
            @if (Model.PrescriptionRequired)
            {
                <span class="badge mb-2" style="background-color: #fef3c7; color: #92400e;">
                    <i class="bi bi-file-medical me-1"></i>Prescription Required
                </span>
            }
            @if (Model.ExpiryDate.HasValue && Model.ExpiryDate.Value <= DateTime.UtcNow.AddMonths(3))
            {
                <span class="badge bg-warning text-dark mb-2">
                    <i class="bi bi-clock-history me-1"></i>Expires @Model.ExpiryDate.Value.ToString("MMM yyyy")
                </span>
            }
            <div class="mt-auto">
                <div class="fw-bold mb-2" style="color: var(--primary-teal);">NPR @Model.Price.ToString("N2")</div>
                @if (Model.StockQuantity > 0)
                {
                    if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-primary-custom btn-sm w-100">
                                <i class="bi bi-cart-plus me-1"></i>Add to Cart
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Url.Action("Details", "Products", new { slug = Model.Slug })"
                           class="btn btn-primary-custom btn-sm w-100">
                            <i class="bi bi-cart-plus me-1"></i>Add to Cart
                        </a>
                    }
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-sm w-100" disabled>Out of Stock</button>
                }
            </div>
        </div>
    </div>
</div>
