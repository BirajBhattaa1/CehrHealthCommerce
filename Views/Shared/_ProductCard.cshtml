@model CehrHealthCommerce.Models.Product

<div class="col">
    <div class="card h-100 product-card shadow-sm border-0">
        <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="text-decoration-none">
            <div class="product-thumb">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" loading="lazy" />
                }
                else
                {
                    <div class="product-thumb-placeholder"><i class="bi bi-capsule"></i></div>
                }
            </div>
        </a>
        <div class="card-body d-flex flex-column">
            <span class="badge bg-light text-muted align-self-start mb-1">@Model.Category?.Name</span>
            <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="text-decoration-none text-dark">
                <h3 class="h6 card-title">@Model.Name</h3>
            </a>
            @if (Model.PrescriptionRequired)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis align-self-start mb-2">
                    <i class="bi bi-file-medical"></i> Prescription
                </span>
            }
            <div class="mt-auto">
                <div class="fw-bold text-brand mb-2">Rs. @Model.Price.ToString("N2")</div>
                @if (Model.StockQuantity > 0)
                {
                    if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-sm btn-brand w-100">
                                <i class="bi bi-cart-plus"></i> Add to cart
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Url.Action("Details", "Products", new { slug = Model.Slug })"
                           class="btn btn-sm btn-brand w-100">
                            <i class="bi bi-cart-plus"></i> Add to cart
                        </a>
                    }
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary w-100" disabled>Out of stock</button>
                }
            </div>
        </div>
    </div>
</div>
