@{
    var metaDescription = ViewData["MetaDescription"] as string
        ?? "Nepal MediHub - a national health marketplace for all of Nepal. Order medicines, health supplies and medical equipment online with delivery across all seven provinces.";
    var pageTitle = ViewData["Title"] as string;
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@metaDescription" />
    <link rel="canonical" href="@canonicalUrl" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? "Nepal MediHub - National Health Marketplace" : $"{pageTitle} - Nepal MediHub")</title>

    <meta property="og:site_name" content="Nepal MediHub" />
    <meta property="og:title" content="@(pageTitle ?? "Nepal MediHub")" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />

    <partial name="_GoogleAnalytics" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
        <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm navbar-gradient">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill me-2"></i>
                    <span class="fw-bold">Nepal MediHub</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Medicines</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Categories">Categories</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About Us</a></li>
                    </ul>
                    <form class="d-flex me-lg-3 my-2 my-lg-0" role="search" asp-controller="Products" asp-action="Index" method="get">
                        <input class="form-control form-control-sm" type="search" placeholder="Search medicines..." aria-label="Search" name="q" value="@Context.Request.Query["q"]" style="min-width: 200px;" />
                    </form>
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item">@await Component.InvokeAsync("CartSummary")</li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-white border-top mt-auto">
        <div class="container py-4">
            <div class="row gy-4">
                <div class="col-md-5">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-heart-pulse-fill me-2" style="font-size: 1.5rem; color: var(--primary-teal);"></i>
                        <span class="fw-bold" style="color: var(--primary-teal);">Nepal MediHub</span>
                    </div>
                    <p class="text-muted small mb-2">A national health marketplace serving all seven provinces of Nepal with medicines, health supplies and medical equipment.</p>
                    <p class="small mb-2" style="color: var(--medical-red);"><i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Medical Disclaimer:</strong> For medical emergencies, call 102 (National Ambulance Service) or 103 (Nepal Police Emergency).</p>
                </div>
                <div class="col-md-2 col-6">
                    <div class="fw-semibold mb-2" style="color: var(--text-charcoal);">Shop</div>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><a class="link-secondary text-decoration-none" asp-controller="Products" asp-action="Index">All Medicines</a></li>
                        <li class="mb-1"><a class="link-secondary text-decoration-none" asp-controller="Products" asp-action="Categories">Categories</a></li>
                        <li class="mb-1"><a class="link-secondary text-decoration-none" asp-controller="Cart" asp-action="Index">Shopping Cart</a></li>
                    </ul>
                </div>
                <div class="col-md-2 col-6">
                    <div class="fw-semibold mb-2" style="color: var(--text-charcoal);">Account</div>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><a class="link-secondary text-decoration-none" asp-controller="Account" asp-action="Login">Sign In</a></li>
                        <li class="mb-1"><a class="link-secondary text-decoration-none" asp-controller="Account" asp-action="Register">Register</a></li>
                        <li class="mb-1"><a class="link-secondary text-decoration-none" asp-controller="Orders" asp-action="Index">My Orders</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <div class="fw-semibold mb-2" style="color: var(--text-charcoal);">Information</div>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="About">About Us</a></li>
                        <li class="mb-1"><span class="text-muted">Delivery across all 7 provinces</span></li>
                        <li class="mb-1"><span class="text-muted">Simulated NID &middot; no government connection</span></li>
                    </ul>
                </div>
            </div>
            <hr class="my-3" />
            <div class="row">
                <div class="col-12 text-center text-md-start mb-3">
                    <p class="text-muted small mb-1">&copy; @DateTime.Now.Year Nepal MediHub. All rights reserved.</p>
                    <p class="disclaimer-text text-muted mb-0">Academic CSC381 Project &middot; TU BSc CSIT 6th Semester</p>
                </div>
                <div class="col-12">
                    <partial name="_Disclaimer" />
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
