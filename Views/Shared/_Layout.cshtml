@{
    var metaDescription = ViewData["MetaDescription"] as string
        ?? "CEHR Health — buy medicines, medical equipment and health products online in Nepal. A CSC381 health e-commerce project.";
    var pageTitle = ViewData["Title"] as string;
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@metaDescription" />
    <link rel="canonical" href="@canonicalUrl" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? "CEHR Health" : pageTitle + " - CEHR Health")</title>

    <!-- Open Graph tags for richer link previews (SEO) -->
    <meta property="og:site_name" content="CEHR Health" />
    <meta property="og:title" content="@(pageTitle ?? "CEHR Health")" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />

    <partial name="_GoogleAnalytics" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-brand shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill"></i> CEHR <span class="fw-light">Health</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Medicines">Medicines</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Equipment">Medical Equipment</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="HealthProducts">Health Products</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Categories">Categories</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                    </ul>
                    <form class="d-flex me-lg-3 my-2 my-lg-0" role="search" asp-controller="Products" asp-action="Index" method="get">
                        <input class="form-control form-control-sm" type="search" placeholder="Search products" aria-label="Search" name="q" value="@Context.Request.Query["q"]" />
                    </form>
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item">@await Component.InvokeAsync("CartSummary")</li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-light border-top mt-auto">
        <div class="container py-4">
            <div class="row gy-3">
                <div class="col-md-6">
                    <div class="fw-bold text-brand"><i class="bi bi-heart-pulse-fill"></i> CEHR Health</div>
                    <p class="text-muted mb-1 small">A health-focused e-commerce platform built for the CSC381 E-Commerce course, in the context of Nepal's e-governance and the proposed Centralized Electronic Health Record (CEHR).</p>
                    <p class="disclaimer text-muted mb-0"><strong>Disclaimer:</strong> This is an academic project. NID is a simulated local identifier and is <em>not</em> connected to any Government of Nepal system. Payments use sandbox/test mode only.</p>
                </div>
                <div class="col-md-3">
                    <div class="fw-semibold mb-2">Shop</div>
                    <ul class="list-unstyled small mb-0">
                        <li><a class="link-secondary text-decoration-none" asp-controller="Products" asp-action="Medicines">Medicines</a></li>
                        <li><a class="link-secondary text-decoration-none" asp-controller="Products" asp-action="Equipment">Medical Equipment</a></li>
                        <li><a class="link-secondary text-decoration-none" asp-controller="Products" asp-action="HealthProducts">Health Products</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <div class="fw-semibold mb-2">Account</div>
                    <ul class="list-unstyled small mb-0">
                        <li><a class="link-secondary text-decoration-none" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li><a class="link-secondary text-decoration-none" asp-controller="Account" asp-action="Register">Register</a></li>
                        <li><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="About">About CEHR</a></li>
                    </ul>
                </div>
            </div>
            <hr />
            <div class="text-center text-muted small">&copy; @DateTime.Now.Year CEHR Health — CSC381 Academic Project. All data is fictional/sample.</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
