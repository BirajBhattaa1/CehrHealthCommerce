@model IReadOnlyList<CehrHealthCommerce.Models.Product>
@{
    ViewData["Title"] = "Home";
    ViewData["MetaDescription"] = "CEHR Health — buy medicines, medical equipment and health products online in Nepal. Simulated NID citizen identity; sandbox payments.";
}

<section class="hero p-4 p-md-5 mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h1 class="display-5 fw-bold">Your health, delivered.</h1>
            <p class="lead text-muted">Order medicines, medical equipment and everyday health products from a single trusted platform — built for Nepal, and designed to connect with the national CEHR ecosystem in the future.</p>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Products" asp-action="Medicines" class="btn btn-brand btn-lg">Browse Medicines</a>
                <a asp-controller="Products" asp-action="Equipment" class="btn btn-outline-secondary btn-lg">Medical Equipment</a>
            </div>
            <p class="text-muted small mt-3 mb-0"><i class="bi bi-shield-check text-brand"></i> Simulated NID citizen identity &middot; Sandbox payments &middot; Academic CSC381 project</p>
        </div>
        <div class="col-lg-5 text-center">
            <i class="bi bi-heart-pulse-fill text-brand" style="font-size:9rem;"></i>
        </div>
    </div>
</section>

<h2 class="h4 mb-3">Shop by area</h2>
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card category-card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="display-6 text-brand mb-2"><i class="bi bi-capsule"></i></div>
                <h3 class="h5">Medicines</h3>
                <p class="text-muted small mb-3">Pain relief, cold &amp; flu, antibiotics and digestive care. Prescription items are clearly marked.</p>
                <a asp-controller="Products" asp-action="Medicines" class="stretched-link text-decoration-none text-brand">Explore <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card category-card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="display-6 text-brand mb-2"><i class="bi bi-thermometer-half"></i></div>
                <h3 class="h5">Medical Equipment</h3>
                <p class="text-muted small mb-3">Monitoring, diagnostic and mobility equipment for home and clinic.</p>
                <a asp-controller="Products" asp-action="Equipment" class="stretched-link text-decoration-none text-brand">Explore <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card category-card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="display-6 text-brand mb-2"><i class="bi bi-basket"></i></div>
                <h3 class="h5">Health Products</h3>
                <p class="text-muted small mb-3">Vitamins, personal care and mother &amp; baby essentials for everyday wellness.</p>
                <a asp-controller="Products" asp-action="HealthProducts" class="stretched-link text-decoration-none text-brand">Explore <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Featured products</h2>
        <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary">View all</a>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 mb-5">
        @foreach (var p in Model)
        {
            <partial name="_ProductCard" model="p" />
        }
    </div>
}

<section class="row align-items-center g-4 mb-4">
    <div class="col-md-8">
        <h2 class="h4">Part of a bigger vision: CEHR</h2>
        <p class="text-muted mb-2">This store is the working e-commerce component of a larger case study — Nepal's proposed <strong>Centralized Electronic Health Record (CEHR)</strong> under the country's e-governance agenda. Your citizen identity is represented by a <strong>National ID (NID)</strong>, which in a future system could link securely to national health services.</p>
        <a asp-controller="Home" asp-action="About" class="btn btn-sm btn-outline-secondary">Learn about the CEHR concept</a>
    </div>
    <div class="col-md-4 text-center">
        <i class="bi bi-diagram-3 text-brand" style="font-size:5rem;"></i>
    </div>
</section>
