@model IReadOnlyList<CehrHealthCommerce.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<h1 class="h3 mb-4">Shop by category</h1>

@if (!Model.Any())
{
    <div class="alert alert-light border">No categories are available yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var c in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5">
                            <a asp-controller="Products" asp-action="Category" asp-route-slug="@c.Slug"
                               class="text-decoration-none text-dark stretched-link">@c.Name</a>
                        </h2>
                        @if (!string.IsNullOrEmpty(c.Description))
                        {
                            <p class="text-muted small mb-2">@c.Description</p>
                        }
                        @if (c.Children.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var ch in c.Children)
                                {
                                    <span class="badge bg-light text-muted">@ch.Name</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
