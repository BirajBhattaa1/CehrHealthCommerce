@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<h1 class="h3 mb-4">Checkout</h1>

<form asp-controller="Checkout" asp-action="Index" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

    <div class="row g-4">
        <!-- Delivery details -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-truck"></i> Delivery details</h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" autocomplete="tel" placeholder="98XXXXXXXX" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="AddressLine" class="form-label"></label>
                            <input asp-for="AddressLine" class="form-control" autocomplete="street-address" />
                            <span asp-validation-for="AddressLine" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Province" class="form-label"></label>
                            <select asp-for="Province" id="Province" class="form-select">
                                <option value="">-- Select province --</option>
                                @foreach (var p in (IEnumerable<string>)ViewBag.Provinces)
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                            <span asp-validation-for="Province" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="District" class="form-label"></label>
                            <select asp-for="District" id="District" class="form-select" data-selected="@Model.District">
                                <option value="">-- Select district --</option>
                            </select>
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Municipality" class="form-label"></label>
                            <input asp-for="Municipality" class="form-control" placeholder="e.g. Kathmandu Metropolitan City" />
                            <span asp-validation-for="Municipality" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Ward" class="form-label"></label>
                            <input asp-for="Ward" class="form-control" placeholder="e.g. 10" />
                            <span asp-validation-for="Ward" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostalCode" class="form-label"></label>
                            <input asp-for="PostalCode" class="form-control" placeholder="e.g. 44600" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-credit-card"></i> Payment method</h2>

                    <div class="form-check border rounded p-3 mb-2 d-flex align-items-start">
                        <input class="form-check-input mt-1 ms-0 me-2" type="radio" asp-for="PaymentMethod" id="pm-esewa" value="esewa" />
                        <label class="form-check-label" for="pm-esewa">
                            <span class="fw-semibold">eSewa (sandbox)</span>
                            <span class="d-block text-muted small">Pay online through the eSewa test gateway. No real money is charged.</span>
                        </label>
                    </div>
                    <div class="form-check border rounded p-3 d-flex align-items-start">
                        <input class="form-check-input mt-1 ms-0 me-2" type="radio" asp-for="PaymentMethod" id="pm-cod" value="cod" />
                        <label class="form-check-label" for="pm-cod">
                            <span class="fw-semibold">Cash on Delivery</span>
                            <span class="d-block text-muted small">Pay in cash when your order is delivered.</span>
                        </label>
                    </div>
                    <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Order summary -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Order summary</h2>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var line in Model.Cart.Lines)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-semibold">@line.Name</div>
                                    <div class="text-muted small">@line.Quantity × Rs. @line.UnitPrice.ToString("N2")</div>
                                </div>
                                <span class="fw-semibold">Rs. @line.LineTotal.ToString("N2")</span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between"><span class="text-muted">Subtotal</span><span>Rs. @Model.Cart.Subtotal.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Delivery</span><span>Rs. @Model.DeliveryCharge.ToString("N2")</span></div>
                    <hr />
                    <div class="d-flex justify-content-between h5"><span>Total</span><span class="text-brand">Rs. @Model.Total.ToString("N2")</span></div>

                    <button type="submit" class="btn btn-brand w-100 mt-3">
                        <i class="bi bi-bag-check"></i> Place order
                    </button>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-link w-100 mt-1"><i class="bi bi-arrow-left"></i> Back to cart</a>
                    <p class="text-muted small mt-3 mb-0">
                        This is an academic demo. NID identity is simulated locally and eSewa runs in sandbox mode — no real payment is processed.
                    </p>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const geo = @Html.Raw(ViewBag.GeoJson);
            const provinceEl = document.getElementById('Province');
            const districtEl = document.getElementById('District');
            const preselected = districtEl.getAttribute('data-selected') || '';

            function fillDistricts(province, selected) {
                districtEl.innerHTML = '<option value="">-- Select district --</option>';
                (geo[province] || []).forEach(function (d) {
                    const opt = document.createElement('option');
                    opt.value = d;
                    opt.textContent = d;
                    if (d === selected) opt.selected = true;
                    districtEl.appendChild(opt);
                });
            }

            provinceEl.addEventListener('change', function () {
                fillDistricts(this.value, '');
            });

            // Repopulate on load so a validation post-back keeps the chosen district.
            if (provinceEl.value) {
                fillDistricts(provinceEl.value, preselected);
            }
        })();
    </script>
}
