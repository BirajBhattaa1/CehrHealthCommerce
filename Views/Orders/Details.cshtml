@model Order
@{
    ViewData["Title"] = $"Order #{Model.OrderId}";
    var subtotal = Model.Items.Sum(i => i.LineTotal);
    var delivery = Model.TotalAmount - subtotal;
}

@functions {
    static string StatusClass(OrderStatus s) => s switch
    {
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Shipped => "bg-info text-dark",
        OrderStatus.Processing => "bg-primary",
        OrderStatus.Confirmed => "bg-primary",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
    static string PayClass(PaymentStatus s) => s switch
    {
        PaymentStatus.Successful => "bg-success",
        PaymentStatus.Failed => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">My orders</a></li>
        <li class="breadcrumb-item active" aria-current="page">Order #@Model.OrderId</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">Order #@Model.OrderId</h1>
        <span class="text-muted small">Placed @Model.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
    </div>
    <div>
        <span class="badge @StatusClass(Model.OrderStatus) fs-6">@Model.OrderStatus</span>
        <span class="badge @PayClass(Model.PaymentStatus) fs-6">Payment: @Model.PaymentStatus</span>
    </div>
</div>

@if (Model.PaymentStatus == PaymentStatus.Pending && Model.Payment?.Method == "eSewa")
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span><i class="bi bi-exclamation-triangle"></i> This order is awaiting payment.</span>
        <a asp-controller="Payment" asp-action="Pay" asp-route-orderId="@Model.OrderId" class="btn btn-sm btn-brand">Complete payment</a>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Items</h2>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Unit price</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-end">Rs. @item.UnitPrice.ToString("N2")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end fw-semibold">Rs. @item.LineTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end text-muted">Subtotal</td>
                                <td class="text-end">Rs. @subtotal.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end text-muted">Delivery</td>
                                <td class="text-end">Rs. @delivery.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end h6 mb-0">Total</td>
                                <td class="text-end h6 mb-0 text-brand">Rs. @Model.TotalAmount.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3"><i class="bi bi-geo-alt"></i> Delivery address</h2>
                <p class="mb-1 fw-semibold">@Model.FullName</p>
                <p class="mb-1 text-muted small">@Model.Phone<br />@Model.Email</p>
                <p class="mb-0 small">
                    @Model.AddressLine<br />
                    @Model.Municipality@(string.IsNullOrEmpty(Model.Ward) ? "" : $", Ward {Model.Ward}")<br />
                    @Model.District, @Model.Province@(string.IsNullOrEmpty(Model.PostalCode) ? "" : $" - {Model.PostalCode}")
                </p>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6 mb-3"><i class="bi bi-credit-card"></i> Payment</h2>
                @if (Model.Payment != null)
                {
                    <div class="d-flex justify-content-between"><span class="text-muted">Method</span><span>@Model.Payment.Method</span></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Status</span><span class="badge @PayClass(Model.Payment.PaymentStatus)">@Model.Payment.PaymentStatus</span></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Amount</span><span>Rs. @Model.Payment.Amount.ToString("N2")</span></div>
                    @if (!string.IsNullOrEmpty(Model.Payment.GatewayRef))
                    {
                        <div class="d-flex justify-content-between"><span class="text-muted">Ref</span><span class="small">@Model.Payment.GatewayRef</span></div>
                    }
                    <div class="text-muted small mt-2">Txn: @Model.Payment.TransactionUuid</div>
                }
                else
                {
                    <p class="text-muted small mb-0">No payment record.</p>
                }
            </div>
        </div>
    </div>
</div>
