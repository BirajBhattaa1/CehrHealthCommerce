@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "My orders";
}

@functions {
    static string StatusClass(OrderStatus s) => s switch
    {
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Shipped => "bg-info text-dark",
        OrderStatus.Processing => "bg-primary",
        OrderStatus.Confirmed => "bg-primary",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
    static string PayClass(PaymentStatus s) => s switch
    {
        PaymentStatus.Successful => "bg-success",
        PaymentStatus.Failed => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">My orders</h1>
    <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-bag"></i> Continue shopping</a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-receipt text-muted" style="font-size:4rem;"></i>
        <p class="text-muted mt-3">You have not placed any orders yet.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary-custom">Browse products</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Date</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="fw-semibold">#@o.OrderId</td>
                        <td class="text-muted small">@o.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">Rs. @o.TotalAmount.ToString("N2")</td>
                        <td><span class="badge @StatusClass(o.OrderStatus)">@o.OrderStatus</span></td>
                        <td>
                            <span class="badge @PayClass(o.PaymentStatus)">@o.PaymentStatus</span>
                            @if (o.Payment != null)
                            {
                                <span class="text-muted small d-block">@o.Payment.Method</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@o.OrderId" class="btn btn-sm btn-outline-primary">View details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
