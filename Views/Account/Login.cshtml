@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["MetaDescription"] = "Sign in to your Nepal MediHub account to order medicines and track your purchase history.";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <i class="bi bi-heart-pulse-fill" style="font-size: 3rem; color: var(--primary-teal);"></i>
            <h1 class="h3 mt-3 mb-2">Sign In to Your Account</h1>
            <p class="text-muted small">Access your medical orders and health profile</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="username" autofocus required />
                <span asp-validation-for="Email" class="form-validation-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required />
                <span asp-validation-for="Password" class="form-validation-error"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100">Sign In</button>
        </form>

        <p class="text-center text-muted small mt-4 mb-0">
            New to Nepal MediHub? <a asp-controller="Account" asp-action="Register" style="color: var(--primary-teal);">Create an account</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
